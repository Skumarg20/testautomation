# Copy to .env and fill in. QA/UAT/pre-production tenant only, never production. Never commit real values.
# App host (where the logged-in app lives). For premargbooks: https://premargbooks.com
MARGBOOKS_QA_URL=http://localhost:4200
MARGBOOKS_API_URL=
# Login host, if different from the app host. Blank = <QA_URL>/login. For premargbooks: https://accounts.premargbooks.com/login
MARGBOOKS_LOGIN_URL=
# single_step: #userid + #password + #btnSave (UAT/preprod).  two_step: #userid, #SIGNin, then #password.
# premargbooks uses two_step.
LOGIN_STYLE=single_step
QA_CHEMIST_USER=
QA_CHEMIST_PASS=
QA_PHARMA_USER=
QA_PHARMA_PASS=
QA_RETAIL_USER=
QA_RETAIL_PASS=
QA_GROCERY_USER=
QA_GROCERY_PASS=
QA_GARMENTS_USER=
QA_GARMENTS_PASS=
# Second identifier (mobile number or e-mail) of the same garments account, for the AU-10 login test.
QA_GARMENTS_ALT_USER=
# Role accounts (same company, different permissions). Tests skip with a reason when missing.
QA_ADMIN_USER=
QA_ADMIN_PASS=
QA_OPERATOR_USER=
QA_OPERATOR_PASS=
QA_ACCOUNTANT_USER=
QA_ACCOUNTANT_PASS=
# Parallel runs (WORKERS=50): one login per worker. Worker N uses entry N, wrapping around when the pool is smaller.
# One JSON line; an account listed here wins over the single QA_<ACCOUNT>_USER/PASS above.
# QA_POOL={"chemist": [["chemist1@qa", "pass1"], ["chemist2@qa", "pass2"]]}
QA_POOL=
