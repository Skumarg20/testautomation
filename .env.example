# ==========================================================
#  Copy to .env aur bharo. NEVER commit .env
#  ZAROORI: value ke SAATH comment mat likhna.
#    THEEK :  BROWSER_MAXIMIZE=true
#    GALAT :  BROWSER_MAXIMIZE=true   <- kuch bhi
# ==========================================================

# Login page ka domain (sabke liye same)
MARGBOOKS_LOGIN_URL=https://accounts.margbooks.com

# App ka domain -- login ke baad address bar me jo dikhe wahi
MARGBOOKS_APP_URL=https://books5.margbooks.com

MARGBOOKS_USER=
MARGBOOKS_PASS=
MARGBOOKS_PIN=
MARGBOOKS_COMPANY=

# false = data likhne wale tests skip + delete requests block
# true karne se pehle 100% pakka karo ki ye DEMO account hai
ALLOW_DESTRUCTIVE=false

# false = browser dikhega
HEADLESS=false

# true = window screen jitni badi (dekhne ke liye best)
BROWSER_MAXIMIZE=true

# BROWSER_MAXIMIZE=false hone par ye size use hoga
VIEWPORT_W=1440
VIEWPORT_H=900

# false = har run pe naye sire se login
USE_SAVED_SESSION=false

SLOWMO_MS=0
DEFAULT_TIMEOUT_MS=20000

# AI features ke liye (optional)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# AI (optional) -- saadhi bhasha ko steps me badalne ke liye.
# Gemini ka free tier hai: aistudio.google.com/apikey
GEMINI_API_KEY=
# Model ka naam khali chhodo -- agent Google se live list lekar
# khud sahi chun lega. Naam badalte rehte hain.
GEMINI_MODEL=
